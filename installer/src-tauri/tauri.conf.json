{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BratanOS Flasher",
  "version": "0.1.0",
  "identifier": "lat.harel.bratanos.flasher",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "BratanOS Flasher",
        "width": 920,
        "height": 600,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "dmg", "nsis"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Flash BratanOS to a USB drive.",
    "longDescription": "BratanOS Flasher writes BratanOS ISO images to removable USB drives. Inspired by balenaEtcher; built with Tauri."
  },
  "plugins": {}
}
