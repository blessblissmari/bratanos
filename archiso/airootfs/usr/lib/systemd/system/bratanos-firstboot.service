[Unit]
Description=BratanOS first-boot setup (Chaotic-AUR keys + paru)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/bratanos/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c '/etc/bratanos/chaotic-aur-setup.sh && pacman -S --noconfirm --needed paru && mkdir -p /var/lib/bratanos && touch /var/lib/bratanos/firstboot.done'
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
