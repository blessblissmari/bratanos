# mkinitcpio preset for the BratanOS live ISO. Generates a single
# archiso-style initramfs at /boot/initramfs-linux.img using the HOOKS
# defined in /etc/mkinitcpio.conf.d/archiso.conf.

ALL_kver="/boot/vmlinuz-linux"

PRESETS=('archiso')

archiso_image="/boot/initramfs-linux.img"
archiso_options="-A archiso,archiso_loop_mnt,archiso_pxe_common,archiso_pxe_nbd,archiso_pxe_http,archiso_pxe_nfs,archiso_kms,memdisk"
