#
# /etc/pacman.d/hooks/99-bratan-tidy.hook
#
# After every package removal, invoke bratan-tidy in --auto mode so orphan
# packages and stale cache entries are cleaned immediately. We deliberately
# DO NOT trigger on Install/Upgrade — those would slow down `pacman -Syu`.
#

[Trigger]
Operation = Remove
Type = Package
Target = *

[Action]
Description = BratanOS: tidy orphans/cache after removal
When = PostTransaction
Exec = /usr/bin/bratan-tidy --auto orphans cache
AbortOnFail = false
