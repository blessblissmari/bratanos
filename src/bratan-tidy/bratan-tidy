#!/usr/bin/env bash
# bratan-tidy — keep BratanOS clean.
#
# Reclaims disk space and removes leftover trash from common Arch sources:
#   - orphan packages (Qtdq)
#   - pacman cache (paccache)
#   - old kernels not currently linked in /boot
#   - leftover .pacnew / .pacsave files
#   - orphan config dirs in $HOME/.config, .cache, .local/share
#   - journal logs older than N days
#   - broken symlinks in /etc and $HOME
#
# Usage:
#   bratan-tidy [--apply | --auto] [--quiet] [TASK ...]
#   bratan-tidy --status
#
# Without --apply, runs as a dry-run and reports what *would* be removed.
# With --auto, runs non-interactive (skips merges, just shows .pacnew list).
#
# Tasks (default = all): orphans cache kernels pacfiles userconfigs journal symlinks
#
# Exit codes: 0 = ok, 1 = task failure, 2 = bad args.

set -uo pipefail

VERSION="0.1.0"
APPLY=0
AUTO=0
QUIET=0
STATUS_ONLY=0

KEEP_CACHE="${BRATAN_KEEP_CACHE:-2}"
KEEP_KERNELS="${BRATAN_KEEP_KERNELS:-2}"
JOURNAL_DAYS="${BRATAN_JOURNAL_DAYS:-14}"

ALL_TASKS=(orphans cache kernels pacfiles userconfigs journal symlinks)
TASKS=()

# ---------- pretty output ----------
if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'
    C_DIM=$'\033[2m'
    C_BOLD=$'\033[1m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_CYAN=$'\033[36m'
else
    C_RESET=""; C_DIM=""; C_BOLD=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""
fi

log()    { ((QUIET)) || printf "%s\n" "$*" >&2; }
hdr()    { ((QUIET)) || printf "\n${C_BOLD}${C_CYAN}» %s${C_RESET}\n" "$*" >&2; }
ok()     { ((QUIET)) || printf "  ${C_GREEN}✓${C_RESET} %s\n" "$*" >&2; }
warn()   { ((QUIET)) || printf "  ${C_YELLOW}!${C_RESET} %s\n" "$*" >&2; }
err()    { printf "  ${C_RED}✗${C_RESET} %s\n" "$*" >&2; }
dryrun() { ((QUIET)) || printf "  ${C_DIM}(dry-run)${C_RESET} %s\n" "$*" >&2; }
note()   { ((QUIET)) || printf "    ${C_DIM}%s${C_RESET}\n" "$*" >&2; }

usage() {
    cat <<EOF
bratan-tidy ${VERSION} — keep BratanOS clean.

Usage:
  bratan-tidy [OPTIONS] [TASK ...]
  bratan-tidy --status

Options:
  --apply              Actually remove things (default is dry-run).
  --auto               Non-interactive mode (used by hooks/timers).
  --quiet              Suppress non-error output.
  --status             Show a summary of reclaimable space and exit.
  --keep-cache=N       Pacman cache versions to keep (default: ${KEEP_CACHE}).
  --keep-kernels=N     Old kernel sets to keep (default: ${KEEP_KERNELS}).
  --journal-days=N     Drop journal entries older than N days (default: ${JOURNAL_DAYS}).
  -h, --help           Show this help.

Tasks (default: all):
  orphans              Remove orphaned packages.
  cache                Trim pacman cache (keeps last N versions).
  kernels              Drop old kernel images/modules.
  pacfiles             Handle .pacnew / .pacsave leftovers.
  userconfigs          Hint at orphan dirs in ~/.config, ~/.cache, ~/.local/share.
  journal              Vacuum systemd journal.
  symlinks             Remove broken symlinks in /etc and \$HOME.

Examples:
  bratan-tidy                       # show what would be cleaned
  sudo bratan-tidy --apply          # actually clean
  sudo bratan-tidy --apply cache    # only trim cache
  sudo bratan-tidy --auto           # silent-ish auto cleanup (used by timer/hook)
EOF
}

# ---------- arg parsing ----------
while (( $# )); do
    case "$1" in
        --apply)            APPLY=1 ;;
        --auto)             APPLY=1; AUTO=1 ;;
        --quiet)            QUIET=1 ;;
        --status)           STATUS_ONLY=1 ;;
        --keep-cache=*)     KEEP_CACHE="${1#*=}" ;;
        --keep-kernels=*)   KEEP_KERNELS="${1#*=}" ;;
        --journal-days=*)   JOURNAL_DAYS="${1#*=}" ;;
        -h|--help)          usage; exit 0 ;;
        --) shift; break ;;
        -*) err "unknown option: $1"; usage; exit 2 ;;
        orphans|cache|kernels|pacfiles|userconfigs|journal|symlinks)
            TASKS+=("$1") ;;
        *) err "unknown task: $1"; usage; exit 2 ;;
    esac
    shift
done

(( ${#TASKS[@]} == 0 )) && TASKS=("${ALL_TASKS[@]}")

# ---------- helpers ----------
need_root_for() {
    local task="$1"
    if [[ $EUID -ne 0 ]]; then
        warn "skipping ${task} (needs root; re-run with sudo)"
        return 1
    fi
    return 0
}

human_size() {
    # Bytes to human-readable.
    numfmt --to=iec --suffix=B --padding=7 "$1" 2>/dev/null || echo "${1}B"
}

du_path() {
    [[ -e "$1" ]] || { echo 0; return; }
    du -sb "$1" 2>/dev/null | awk '{print $1}'
}

# ---------- task: orphans ----------
task_orphans() {
    hdr "orphans"
    command -v pacman >/dev/null || { warn "pacman not found"; return 0; }
    local list
    list="$(pacman -Qtdq 2>/dev/null || true)"
    if [[ -z "$list" ]]; then
        ok "no orphan packages"
        return 0
    fi
    local count
    count=$(printf '%s\n' "$list" | wc -l)
    log "  found ${count} orphan package(s):"
    while IFS= read -r p; do note "- $p"; done <<<"$list"
    if (( APPLY )); then
        need_root_for orphans || return 0
        # Loop until no more orphans (removing one can orphan another)
        local pass=0
        while :; do
            list="$(pacman -Qtdq 2>/dev/null || true)"
            [[ -z "$list" ]] && break
            (( pass++ ))
            log "  pass ${pass}…"
            # shellcheck disable=SC2086
            pacman -Rns --noconfirm $list >/dev/null 2>&1 || {
                err "failed removing orphans"
                return 1
            }
        done
        ok "orphans removed"
    else
        dryrun "would: pacman -Rns ${count} package(s)"
    fi
}

# ---------- task: cache ----------
task_cache() {
    hdr "cache"
    command -v paccache >/dev/null || {
        warn "paccache not found (install pacman-contrib)"
        return 0
    }
    if (( APPLY )); then
        need_root_for cache || return 0
        # Trim system pacman cache.
        paccache -rk"${KEEP_CACHE}" >/dev/null
        # Drop uninstalled package cache entirely.
        paccache -ruk0 >/dev/null
        ok "pacman cache trimmed (kept ${KEEP_CACHE} versions, dropped uninstalled)"
    else
        local removed
        removed=$(paccache -dk"${KEEP_CACHE}" 2>/dev/null | grep -c '^/' || true)
        local removed_un
        removed_un=$(paccache -duk0 2>/dev/null | grep -c '^/' || true)
        dryrun "would remove ${removed} cached versions (keep last ${KEEP_CACHE}) + ${removed_un} uninstalled"
    fi
}

# ---------- task: kernels ----------
task_kernels() {
    hdr "kernels"
    # Real kernel cleanup is delegated to the package manager: anything in
    # /usr/lib/modules without a matching installed package is leftover.
    command -v pacman >/dev/null || { warn "pacman not found"; return 0; }
    local stale=()
    if [[ -d /usr/lib/modules ]]; then
        for d in /usr/lib/modules/*/; do
            [[ -d "$d" ]] || continue
            local ver="${d%/}"; ver="${ver##*/}"
            # Owner check: if no package owns this dir, it is stale.
            if ! pacman -Qoq "$d" >/dev/null 2>&1; then
                stale+=("$d")
            fi
            # Also detect modules dirs from upgrades that left a bare extramodules layout
            if [[ ! -e "${d}vmlinuz" && ! -e "${d}pkgbase" ]]; then
                stale+=("$d")
            fi
        done
    fi
    # De-dup
    if (( ${#stale[@]} )); then
        IFS=$'\n' read -r -d '' -a stale < <(printf '%s\n' "${stale[@]}" | sort -u && printf '\0')
    fi
    if (( ${#stale[@]} == 0 )); then
        ok "no stale kernel module dirs"
        return 0
    fi
    local total=0
    for d in "${stale[@]}"; do
        local sz; sz=$(du_path "$d"); total=$((total + sz))
        note "- $d ($(human_size "$sz"))"
    done
    if (( APPLY )); then
        need_root_for kernels || return 0
        for d in "${stale[@]}"; do rm -rf -- "$d"; done
        ok "removed $(( ${#stale[@]} )) stale modules dir(s) (~$(human_size "$total"))"
    else
        dryrun "would remove ${#stale[@]} dir(s) (~$(human_size "$total"))"
    fi
}

# ---------- task: pacfiles ----------
task_pacfiles() {
    hdr "pacfiles"
    local files=()
    while IFS= read -r f; do files+=("$f"); done < <(find /etc -name '*.pacnew' -o -name '*.pacsave' 2>/dev/null)
    if (( ${#files[@]} == 0 )); then
        ok "no .pacnew or .pacsave files"
        return 0
    fi
    for f in "${files[@]}"; do note "- $f"; done
    if (( AUTO )); then
        log "  ${C_DIM}(auto mode: not touched — review manually with 'pacdiff')${C_RESET}"
        return 0
    fi
    if (( APPLY )); then
        need_root_for pacfiles || return 0
        if command -v pacdiff >/dev/null; then
            ok "launching pacdiff for interactive review…"
            pacdiff || true
        else
            warn "pacdiff not installed (install pacman-contrib); skipping merge"
        fi
    else
        dryrun "would launch pacdiff to merge ${#files[@]} file(s)"
    fi
}

# ---------- task: userconfigs ----------
task_userconfigs() {
    hdr "userconfigs"
    # We never *delete* user data automatically; this task is informational.
    # It flags top-level dirs in ~/.config, ~/.cache, ~/.local/share that don't
    # match any installed binary or package, so the user can inspect.
    local home="${SUDO_USER:+/home/$SUDO_USER}"
    home="${home:-$HOME}"
    [[ -d "$home" ]] || { warn "home dir not found: $home"; return 0; }

    local pkg_owned_bins=()
    if command -v pacman >/dev/null; then
        mapfile -t pkg_owned_bins < <(pacman -Qlq 2>/dev/null \
            | awk '/\/(usr\/)?bin\//{n=split($0,a,"/"); print a[n]}' \
            | sort -u)
    fi
    declare -A KNOWN
    for b in "${pkg_owned_bins[@]}"; do KNOWN["$b"]=1; done

    local hits=0 total=0
    for base in .config .cache .local/share; do
        local root="${home}/${base}"
        [[ -d "$root" ]] || continue
        for entry in "$root"/*; do
            [[ -e "$entry" ]] || continue
            local name; name="$(basename "$entry")"
            # Heuristic: dir is "orphan" if its name doesn't match a known
            # installed binary AND it isn't a known well-known dir.
            case "$name" in
                systemd|gtk-3.0|gtk-4.0|user-dirs.dirs|user-dirs.locale|fontconfig|mimeapps.list|pulse|pulse-cookie|dconf|mc) continue;;
            esac
            if [[ -z "${KNOWN[$name]:-}" ]]; then
                local sz; sz=$(du_path "$entry"); total=$((total + sz))
                note "- $entry ($(human_size "$sz"))"
                hits=$((hits + 1))
            fi
        done
    done
    if (( hits == 0 )); then
        ok "no obvious orphan user-config dirs"
    else
        warn "${hits} suspicious dir(s), ~$(human_size "$total") (review manually — never auto-deleted)"
    fi
}

# ---------- task: journal ----------
task_journal() {
    hdr "journal"
    command -v journalctl >/dev/null || { warn "journalctl not found"; return 0; }
    if (( APPLY )); then
        need_root_for journal || return 0
        journalctl --vacuum-time="${JOURNAL_DAYS}d" 2>&1 | tail -n 3 | while read -r l; do note "$l"; done
        ok "journal vacuumed (>${JOURNAL_DAYS}d)"
    else
        local total
        total=$(journalctl --disk-usage 2>/dev/null \
            | sed -n 's/.*take up \([^ ]*\) in.*/\1/p')
        dryrun "would: journalctl --vacuum-time=${JOURNAL_DAYS}d (current usage: ${total:-unknown})"
    fi
}

# ---------- task: symlinks ----------
task_symlinks() {
    hdr "symlinks"
    local home="${SUDO_USER:+/home/$SUDO_USER}"
    home="${home:-$HOME}"
    local roots=(/etc "$home")
    local broken=()
    for r in "${roots[@]}"; do
        [[ -d "$r" ]] || continue
        while IFS= read -r -d '' l; do broken+=("$l"); done \
            < <(find "$r" -xtype l -not -path '*/\.git/*' -print0 2>/dev/null)
    done
    if (( ${#broken[@]} == 0 )); then
        ok "no broken symlinks"
        return 0
    fi
    for b in "${broken[@]}"; do note "- $b"; done
    if (( APPLY )); then
        for b in "${broken[@]}"; do
            if [[ "$b" == /etc/* ]]; then
                need_root_for "symlinks(/etc)" || continue
            fi
            rm -- "$b"
        done
        ok "removed ${#broken[@]} broken symlink(s)"
    else
        dryrun "would remove ${#broken[@]} broken symlink(s)"
    fi
}

# ---------- status mode ----------
status_only() {
    hdr "BratanOS — tidy status"
    local cache_size journal_size orphans_count pacfiles_count
    cache_size=$(du_path /var/cache/pacman/pkg)
    journal_size=$(journalctl --disk-usage 2>/dev/null \
        | sed -n 's/.*take up \([^ ]*\) in.*/\1/p')
    orphans_count=$(pacman -Qtdq 2>/dev/null | wc -l)
    pacfiles_count=$(find /etc \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null | wc -l)
    printf "  pacman cache:        %s\n" "$(human_size "${cache_size:-0}")"
    printf "  journal:             %s\n" "${journal_size:-unknown}"
    printf "  orphan packages:     %s\n" "${orphans_count}"
    printf "  pacnew/pacsave:      %s\n" "${pacfiles_count}"
    printf "\nRun ${C_BOLD}sudo bratan-tidy --apply${C_RESET} to clean.\n"
}

# ---------- main ----------
if (( STATUS_ONLY )); then
    status_only
    exit 0
fi

if (( APPLY == 0 )); then
    log "${C_DIM}(dry-run — pass --apply to actually remove)${C_RESET}"
fi

rc=0
for t in "${TASKS[@]}"; do
    case "$t" in
        orphans)     task_orphans     || rc=1 ;;
        cache)       task_cache       || rc=1 ;;
        kernels)     task_kernels     || rc=1 ;;
        pacfiles)    task_pacfiles    || rc=1 ;;
        userconfigs) task_userconfigs || rc=1 ;;
        journal)     task_journal     || rc=1 ;;
        symlinks)    task_symlinks    || rc=1 ;;
    esac
done
exit "$rc"
