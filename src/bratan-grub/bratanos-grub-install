#!/usr/bin/env bash
# bratanos-grub-install — install BratanOS GRUB theme and regenerate config.
#
# Generates a wallpaper PNG using ImageMagick (gradient + ASCII logo) and
# wires GRUB_THEME into /etc/default/grub. Idempotent.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "must be root" >&2
    exit 1
fi

THEME_SRC="/usr/share/grub/themes/bratanos"
THEME_DST="/boot/grub/themes/bratanos"
DEFAULTS="/etc/default/grub"

if [[ ! -d "$THEME_SRC" ]]; then
    echo "[bratanos] theme source missing: $THEME_SRC" >&2
    exit 1
fi

mkdir -p "$THEME_DST"
cp -r "$THEME_SRC"/. "$THEME_DST"/

# Generate wallpaper if ImageMagick is available; else solid-color fallback
# (theme.txt uses desktop-color so missing background.png is fine).
if command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; then
    IM=$(command -v magick || command -v convert)
    echo "[bratanos] generating wallpaper via ${IM##*/}…"
    "$IM" -size 1920x1080 \
        gradient:'#11111b'-'#1e1e2e' \
        -fill '#89b4fa' -gravity south \
        -font 'DejaVu-Sans-Mono-Bold' -pointsize 24 \
        -annotate +0+60 'BratanOS' \
        "$THEME_DST/background.png" 2>/dev/null || \
    "$IM" -size 1920x1080 xc:'#1e1e2e' "$THEME_DST/background.png"
else
    echo "[bratanos] ImageMagick not found — using solid background only"
fi

# Generate a minimal "logo" image (just the wordmark in accent color).
if command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; then
    IM=$(command -v magick || command -v convert)
    "$IM" -size 400x80 xc:none \
        -fill '#89b4fa' -gravity center \
        -font 'DejaVu-Sans-Mono-Bold' -pointsize 48 \
        -annotate +0+0 'BratanOS' \
        "$THEME_DST/logo.png" 2>/dev/null || true
fi

# Wire it into /etc/default/grub.
if grep -q '^GRUB_THEME=' "$DEFAULTS"; then
    sed -i "s|^GRUB_THEME=.*|GRUB_THEME=\"$THEME_DST/theme.txt\"|" "$DEFAULTS"
else
    printf '\n# BratanOS theme\nGRUB_THEME="%s/theme.txt"\n' "$THEME_DST" >> "$DEFAULTS"
fi
# Ensure timeout long enough to actually see the theme.
if ! grep -q '^GRUB_TIMEOUT=' "$DEFAULTS"; then
    echo 'GRUB_TIMEOUT=5' >> "$DEFAULTS"
fi
# Higher resolution for the theme to look right.
if grep -q '^GRUB_GFXMODE=' "$DEFAULTS"; then
    sed -i 's|^GRUB_GFXMODE=.*|GRUB_GFXMODE=auto|' "$DEFAULTS"
else
    echo 'GRUB_GFXMODE=auto' >> "$DEFAULTS"
fi

echo "[bratanos] regenerating grub.cfg…"
grub-mkconfig -o /boot/grub/grub.cfg

echo "[bratanos] done. Reboot to see the new GRUB theme."
